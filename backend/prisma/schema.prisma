generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tech {
  id       String        @id @default(cuid())
  name     String        @unique
  category TechCategory
  imageUrl String?
  color    String?
  projects ProjectTech[]
}

model Skill {
  id           String             @id @default(cuid())
  name         String             @unique
  category     SkillCategory
  certificates CertificateSkill[]
  experiences  ExperienceSkill[]
  projects     ProjectSkill[]
}

model Project {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  shortDescription String
  fullDescription  String
  githubUrl        String?
  liveUrl          String?
  isVisible        Boolean        @default(true)
  featured         Boolean        @default(false)
  displayOrder     Int            @default(1)
  status           ProjectStatus
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  projectYear      Int
  thumbnailUrl     String
  gallery          ProjectImage[]
  skills           ProjectSkill[]
  techs            ProjectTech[]
}

model ProjectImage {
  id           String  @id @default(cuid())
  imageUrl     String
  displayOrder Int
  projectId    String
  caption      String?
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model ProjectTech {
  projectId String
  techId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tech      Tech    @relation(fields: [techId], references: [id], onDelete: Cascade)

  @@id([projectId, techId])
}

model Issuer {
  id           String        @id @default(cuid())
  name         String        @unique
  logo         String?
  certificates Certificate[]
}

model Certificate {
  id            String             @id @default(cuid())
  title         String
  credentialUrl String
  badgeImageUrl String?
  isVisible     Boolean            @default(true)
  featured      Boolean            @default(false)
  displayOrder  Int                @default(1)
  issueDate     DateTime
  expiryDate    DateTime?
  issuerId      String
  issuer        Issuer             @relation(fields: [issuerId], references: [id])
  skills        CertificateSkill[]
}

model CertificateSkill {
  certificateId String
  skillId       String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([certificateId, skillId])
}

model Experience {
  id               String            @id @default(cuid())
  company          String
  role             String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isVisible        Boolean           @default(true)
  currentlyWorking Boolean           @default(false)
  displayOrder     Int               @default(1)
  companyImageUrl  String?
  points           ExperiencePoint[]
  skills           ExperienceSkill[]
}

model ExperiencePoint {
  id           String     @id @default(cuid())
  content      String
  displayOrder Int
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model ExperienceSkill {
  experienceId String
  skillId      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
}

model Profile {
  id              String  @id @default(cuid())
  name            String
  email           String
  phone           String?
  location        String?
  resumeUrl       String?
  profileImageUrl String?
  about           About?
  hero            Hero?
}

model Hero {
  id           String  @id @default(cuid())
  heroTitle    String?
  tagline      String?
  description  String?
  availability String?
  heroImageUrl String?
  profileId    String  @unique
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model About {
  id         String      @id @default(cuid())
  heading    String?
  content    String?
  profileId  String      @unique
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  highlights Highlight[]
}

model Highlight {
  id      String @id @default(cuid())
  stat    String
  label   String
  order   Int    @default(1)
  aboutId String
  about   About  @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Education {
  id                  String    @id @default(cuid())
  institution         String
  degree              String
  fieldOfStudy        String
  grade               String?
  location            String?
  startDate           DateTime
  endDate             DateTime?
  currentlyStudying   Boolean   @default(false)
  institutionImageUrl String?
}

model SocialLink {
  id           String         @id @default(cuid())
  platform     SocialPlatform @unique
  url          String
  displayOrder Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  LANGUAGE
  FRAMEWORK
  DEVOPS
  CLOUD
  TOOLS
  ML_AI
  DATA_ANALYSIS
  DATA_VISUALIZATION
  DEPLOYMENT
}

enum SkillCategory {
  SOFTWARE_DEVELOPMENT
  DATA_SCIENCE
  MACHINE_LEARNING
  ARTIFICIAL_INTELLIGENCE
  DATABASES
  DEVOPS
  CLOUD
  VERSION_CONTROL
  TESTING
  UI_UX
  SOFT_SKILLS
  FRONTEND
  BACKEND
  DATA_ANALYTICS
  COMPUTER_VISION
  NLP_LLM
  MLOPS
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
}

enum SocialPlatform {
  GITHUB
  LINKEDIN
  LEETCODE
  CODEFORCES
  CODECHEF
  HACKERRANK
  TWITTER
  INSTAGRAM
  EMAIL
  OTHER
}

enum RagSourceType {
  PROJECT
  EXPERIENCE
  CERTIFICATE
  EDUCATION
  PROFILE
}

model RagDocument {
  id         String        @id @default(cuid())
  sourceType RagSourceType
  sourceId   String
  title      String

  chunks     RagChunk[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([sourceType, sourceId])
}

model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  Unsupported("vector")

  document RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, chunkIndex])
}